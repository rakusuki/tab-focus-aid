{
  "manifest_version": 3,
  "name": "Tab Focus Aid",
  "version": "0.4.0",
  "description": "Make click targets keyboard-accessible on sites you explicitly allow.",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
